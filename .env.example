# Basispfad der Seite für vite build. Nur der Pages-Workflow setzt "/<repo>/", sonst "/".
BASE_PATH=/
# Kein echter Schalter: Vite setzt import.meta.env.BASE_URL (aus BASE_PATH) und
# import.meta.env.DEV selbst. Das Gate von defuss-vae zählt sie als Umgebungsvariablen.
BASE_URL=/
DEV=

# infra/ (CDK, infra/README.md): diese Werte in infra/.env.local eintragen (gitignored), nicht hier.
# AWS-Profil aus ~/.aws/config, mit dem `bun run deploy` arbeitet.
AWS_PROFILE=
# Empfänger des Budget-Alarms (über 5 $ im Monat), mit Komma getrennt.
BUDGET_EMAILS=
# Nur wenn es im Konto schon einen OIDC-Anbieter für GitHub gibt: seine ARN.
GITHUB_OIDC_PROVIDER_ARN=
# Kein echter Schalter: Die CDK-CLI setzt das Konto aus dem Profil selbst.
CDK_DEFAULT_ACCOUNT=
